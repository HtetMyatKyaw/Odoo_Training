<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="real_estate_properties_type_view_list" model="ir.ui.view">
        <field name="name">real.estate.properties.type.list</field>
        <field name="model">real.estate.properties.type</field>
        <field name="arch" type="xml">
            <list string="Property Types">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="real_estate_properties_type_view_form" model="ir.ui.view">
        <field name="name">real.estate.properties.type.form</field>
        <field name="model">real.estate.properties.type</field>
        <field name="arch" type="xml">
            <form string="Property Type">
                <sheet>
                    <group>
                        <field name="name" placeholder="e.g. Home" required="1"/>
                    </group>
                    <notebook>
                        <page string="Properties" name="properties">
                            <field name="property_ids" readonly="1">
                                <list string="Properties" create="0" delete="0"
                                      decoration-success="status == 'sold'">
                                    <field name="property_reference"/>
                                    <field name="name"/>
                                    <field name="postcode"/>
                                    <field name="expected_price"/>
                                    <field name="selling_price"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_real_estate_properties_type" model="ir.actions.act_window">
        <field name="name">Property Types</field>
        <field name="res_model">real.estate.properties.type</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('name', '!=', False)]</field>
    </record>
</odoo>
