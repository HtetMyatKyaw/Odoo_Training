<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_real_estate_list" model="ir.ui.view">
        <field name="name">real.estate.list</field>
        <field name="model">real.estate</field>
        <field name="arch" type="xml">
            <list string="Properties" decoration-success="status == 'sold'">
                <field name="property_reference"/>
                <field name="name"/>
                <field name="property_type_id"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="postcode"/>
                <field name="expected_price"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="expected_price"/>
                <field name="selling_price" readonly="1"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_real_estate_form" model="ir.ui.view">
        <field name="name">real.estate.form</field>
        <field name="model">real.estate</field>
        <field name="arch" type="xml">
            <form string="Property">
                <header>
                    <button name="action_sold" type="object" string="Sold"
                            class="oe_highlight" invisible="status != 'offer_accepted'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="status in ('sold', 'cancel')"/>
                    <field name="status" widget="statusbar"
                           class="hmk_property_statusbar"
                           statusbar_visible="new,offer_received,offer_accepted,sold"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Property name" readonly="status in ('sold', 'cancel')"/>
                        </h1>
                        <field name="tag_ids" widget="many2many_tags"
                               invisible="status in ('sold', 'cancel')"
                               options="{'color_field': 'color'}"
                               placeholder="Select tags..."/>
                        <field name="tag_ids" widget="many2many_tags"
                               invisible="status not in ('sold', 'cancel')" readonly="1"
                               options="{'color_field': 'color', 'no_edit_color': True}"/>
                    </div>
                    <group>
                        <group>
                            <field name="property_reference" readonly="1"
                                   placeholder="Assigned on save"/>
                            <field name="property_type_id"
                                   readonly="status in ('sold', 'cancel')"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="postcode" readonly="status in ('sold', 'cancel')"/>
                            <field name="date_availability" string="Available From" readonly="status in ('sold', 'cancel')"/>
                        </group>
                        <group>
                            <field name="expected_price" readonly="status in ('sold', 'cancel')"/>
                            <field name="selling_price" readonly="1"/>
                            <field name="best_offer" readonly="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <group>
                                <field name="description" readonly="status in ('sold', 'cancel')"/>
                                <field name="bedrooms" readonly="status in ('sold', 'cancel')"/>
                                <field name="living_area" string="Living Area (sqm)" readonly="status in ('sold', 'cancel')"/>
                                <field name="facades" readonly="status in ('sold', 'cancel')"/>
                                <field name="garage" readonly="status in ('sold', 'cancel')"/>
                                <field name="garden" readonly="status in ('sold', 'cancel')"/>
                                <field name="garden_area" string="Garden Area (sqm)" readonly="not garden or status in ('sold', 'cancel')"/>
                                <field name="garden_orientation" readonly="not garden or status in ('sold', 'cancel')"/>
                                <field name="total_area"/>
                            </group>
                        </page>
                        <page string="Offers" name="offers">
                            <field name="offer_ids" readonly="status in ('sold', 'cancel')">
                                <list string="Offers" delete="0"
                                      decoration-success="status == 'accepted'"
                                      decoration-danger="status == 'refused'">
                                    <field name="price"/>
                                    <field name="partner_id"/>
                                    <field name="validity"/>
                                    <field name="date_deadline"/>
                                    <button name="action_accept" type="object"
                                            icon="fa-check" title="Accept" invisible="status or parent.status in ('offer_accepted', 'sold', 'cancel')"/>
                                    <button name="action_refuse" type="object"
                                            icon="fa-times" title="Refuse" invisible="status or parent.status in ('sold', 'cancel')"/>
                                    <field name="status" readonly="1" widget="badge"
                                           decoration-success="status == 'accepted'"
                                           decoration-danger="status == 'refused'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Other Info" name="other_info">
                            <group>
                                <field name="user_id" readonly="status in ('sold', 'cancel')"/>
                                <field name="buyer_id" readonly="status in ('sold', 'cancel')"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_real_estate" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">real.estate</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
